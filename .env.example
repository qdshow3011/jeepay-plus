# ============================================================
# OpenHubs PAY 环境变量配置模板
# 复制此文件为 .env 并修改实际值
# Coolify 部署：在 Coolify 环境变量页面配置以下所有变量
# ============================================================

# ---------- MySQL 配置 ----------
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=openhubsdb
MYSQL_USER=openhubs
MYSQL_PASSWORD=replace-with-a-strong-app-password

# ---------- ActiveMQ 配置 ----------
ACTIVEMQ_USER=system
ACTIVEMQ_PASSWORD=replace-with-a-strong-broker-password

# ---------- JWT 密钥配置 ----------
# 至少 32 字节的随机字符串，生产环境务必修改
MANAGER_JWT_SECRET=replace-with-at-least-32-random-bytes
MERCHANT_JWT_SECRET=replace-with-at-least-32-random-bytes

# ---------- CORS 跨域配置 ----------
# 允许的前端来源，多个用逗号分隔
OPENHUBS_CORS_ALLOWED_ORIGINS=http://localhost:9226,http://localhost:9227,http://localhost:9228,https://pay.open-hubs.com,https://mpay.open-hubs.com,https://kpay.open-hubs.com,https://kit.open-hubs.com

# ---------- 域名配置（Coolify Traefik 路由）----------
# 每个域名需在 Cloudflare DNS 配置 A 记录指向 Coolify 服务器 IP
KITFOX_DOMAIN=kit.open-hubs.com
MANAGER_DOMAIN=mpay.open-hubs.com
MERCHANT_DOMAIN=kpay.open-hubs.com
PAYMENT_UI_DOMAIN=pay.open-hubs.com

# ---------- KitfoxPay 易支付协议适配网关 ----------
# 对接 OpenHubs PAY 的商户号和私钥（在运营后台获取）
KITFOX_MCH_NO=M1784708760
KITFOX_APP_ID=6a607e98e4b022b84e41f0e2
KITFOX_PRIVATE_KEY=your_private_key_from_manager

# 易支付协议参数（下游系统对接时使用）
KITFOX_EPAY_PID=1001
KITFOX_EPAY_KEY=replace_with_32_char_md5_key

# KitfoxPay 对外开放的域名（用于回调通知）
KITFOX_SITE_DOMAIN=https://kit.open-hubs.com

# KitfoxPay 管理后台密码
KITFOX_ADMIN_PASSWORD=admin123
