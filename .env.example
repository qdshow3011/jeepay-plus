# ============================================================
# Jeepay 环境变量配置模板
# 复制此文件为 .env 并修改实际值
# Coolify 部署时在 Environment Variables 中配置所有变量
# ============================================================

# ---------- MySQL 配置 ----------
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=jeepaydb
MYSQL_USER=jeepay
MYSQL_PASSWORD=replace-with-a-strong-app-password

# ---------- Redis 配置 ----------
# (可选) 如使用外部 Redis 可配置，默认使用 docker-compose 内部 Redis
# REDIS_HOST=redis
# REDIS_PORT=6379

# ---------- ActiveMQ 配置 ----------
ACTIVEMQ_USER=system
ACTIVEMQ_PASSWORD=replace-with-a-strong-broker-password

# ---------- JWT 密钥配置 ----------
# 至少 32 字节的随机字符串，生产环境务必修改
MANAGER_JWT_SECRET=replace-with-at-least-32-random-bytes
MERCHANT_JWT_SECRET=replace-with-at-least-32-random-bytes

# ---------- CORS 跨域配置 ----------
# 允许的前端来源，多个用逗号分隔
# Coolify 部署时请填写你的实际域名，例如：
# JEEPAY_CORS_ALLOWED_ORIGINS=https://manager.yourdomain.com,https://merchant.yourdomain.com,https://pay.yourdomain.com
JEEPAY_CORS_ALLOWED_ORIGINS=http://localhost:9226,http://localhost:9227,http://localhost:9228