# Ensure LF line endings for files used in Linux containers
# Windows CRLF will break shell scripts and Dockerfiles in Docker builds
*.sh text eol=lf
Dockerfile text eol=lf
*.template text eol=lf
docker-entrypoint.sh text eol=lf

# YAML and XML config files
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf

# Source code
*.js text eol=lf
*.ts text eol=lf
*.java text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sql text eol=lf

# Properties files
*.properties text eol=lf
